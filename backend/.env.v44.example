# ============================================================
# V44.9 PRODUCTION CONFIGURATION
# ============================================================

# ------------------------------------------------------------
# MASTER CONTROL
# ------------------------------------------------------------

# 0 = STOP
# 1 = ACTIVE
V44_ENABLED=0

# IMPORTANT:
# Keep 1 until final production verification.
V44_DRY_RUN=1

# ------------------------------------------------------------
# V44 HARD AI BUDGET
# ------------------------------------------------------------

# Never increase above OpenRouter/provider safe limit.
V44_DAILY_AI_LIMIT=50

# V44 sends exactly one downstream AI request per autonomous cycle.
# The underlying Moltbook module also receives this limit explicitly.
V44_MAX_AI_PER_CYCLE=1

# ------------------------------------------------------------
# TIMING
# ------------------------------------------------------------

V44_TIMEZONE=Asia/Bangkok

# 20 minutes spreads up to ~50 requests across the active day.
V44_MIN_SECONDS_BETWEEN_CYCLES=1200

V44_COOLDOWN_MINUTES=30

# ------------------------------------------------------------
# AUTONOMOUS REPLY SAFETY
# ------------------------------------------------------------

V44_MAX_REPLIES_PER_DAY=10
V44_MAX_REPLIES_PER_THREAD=3
V44_MAX_RETRY_ATTEMPTS=2

# ------------------------------------------------------------
# ADAPTIVE LEARNING
# ------------------------------------------------------------

V44_MIN_SAMPLES_FOR_ADAPTATION=10
V44_LEARNING_RATE=0.15
V44_EXPLORATION_RATE=0.20

# ------------------------------------------------------------
# MOLTBOOK INTERACTION
# ------------------------------------------------------------

MOLTBOOK_INTERACTION_FEED_LIMIT=40
MOLTBOOK_INTERACTION_MIN_RELEVANCE=0.30

# Existing module safety setting.
# V44 overrides this to ONE request per autonomous cycle.
MOLTBOOK_AI_BATCH_SIZE=1
MOLTBOOK_AI_REQUEST_BUDGET=1

# Existing comment-cycle safety.
MOLTBOOK_INTERACTION_MAX_COMMENTS_PER_CYCLE=1
MOLTBOOK_COMMENT_SIMILARITY_THRESHOLD=0.72

# ------------------------------------------------------------
# RESEARCH DISCUSSION
# ------------------------------------------------------------

MOLTBOOK_MAX_AUTO_REPLIES_PER_CYCLE=1

# V44 directly controls research discussion calls.
MOLTBOOK_COMMENT_WATCH_ENABLED=false
MOLTBOOK_AUTO_REPLY_ENABLED=false

# ------------------------------------------------------------
# AI PROVIDER
# ------------------------------------------------------------

AI_PROVIDER=openrouter
AI_MODEL=google/gemini-3.8-flash

# DO NOT PUT API KEYS IN THIS FILE.
# Keep RESEARCH_AI_API_KEY / OPENROUTER_API_KEY in Render Secrets.

# ------------------------------------------------------------
# MEMORY
# ------------------------------------------------------------

# Local Termux:
# backend/data/v44_autonomous.db

# Render paid persistent disk example:
# V44_DB_PATH=/var/data/v44_autonomous.db

V44_DB_PATH=backend/data/v44_autonomous.db
