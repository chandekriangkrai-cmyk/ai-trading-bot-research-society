# Core
DATABASE_URL=sqlite:///./research.db
CORS_ORIGINS=*

# Research
RESEARCH_INPUT_ROOT=research_inputs
RESEARCH_UPLOAD_MAX_MB=512
RESEARCH_MIN_GROUP_N=10
RESEARCH_INITIAL_CAPITAL=10000

# Moltbook
MOLTBOOK_API_BASE=https://www.moltbook.com/api/v1
MOLTBOOK_API_KEY=
MOLTBOOK_SUBMOLT=ai
MOLTBOOK_TIMEOUT_SECONDS=20

# AI provider for Moltbook AI interaction
# Supported: openai, gemini, openrouter
AI_PROVIDER=openrouter
AI_MODEL=openrouter/free
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Legacy/direct OpenAI-compatible settings
RESEARCH_AI_API_KEY=
RESEARCH_AI_BASE_URL=https://api.openai.com/v1
RESEARCH_AI_MODEL=gpt-5.6-luna
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
RESEARCH_AI_TIMEOUT_SECONDS=45
RESEARCH_AI_MAX_OUTPUT_TOKENS=700

# Discussion automation
# false = generate/store drafts only; true = allow posting replies.
MOLTBOOK_AUTO_REPLY_ENABLED=false
MOLTBOOK_COMMENT_WATCH_ENABLED=false
MOLTBOOK_COMMENT_WATCH_INTERVAL_SECONDS=900
MOLTBOOK_MAX_AUTO_REPLIES_PER_CYCLE=2

# Public-output safety: internal result/file/run IDs stay hidden by default.
PUBLIC_EXPOSE_INTERNAL_IDS=false
# Optional comma-separated proprietary terms that must never appear in public text.
PUBLIC_SECRET_TERMS=

# AI↔AI research interaction loop
# Phase 1 observer/draft mode: false. Phase 3 autonomous comments: true.
MOLTBOOK_AI_INTERACTION_ENABLED=false
MOLTBOOK_AI_INTERACTION_AUTO_COMMENT_ENABLED=false
MOLTBOOK_AI_INTERACTION_INTERVAL_SECONDS=1800
MOLTBOOK_INTERACTION_FEED_LIMIT=40
MOLTBOOK_INTERACTION_MIN_RELEVANCE=0.80
MOLTBOOK_INTERACTION_MAX_COMMENTS_PER_CYCLE=2
MOLTBOOK_INTERACTION_TOPICS=trading,backtest,backtesting,forex,quant,quantitative,research,ea,expert advisor,risk,robustness,walk-forward,out-of-sample,replication
